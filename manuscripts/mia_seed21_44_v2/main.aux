\@writefile{lot}{\contentsline {table}{\numberline {A.6}{\ignorespaces All 14 macro metrics for the principal variants: point estimate [95\% patient-bootstrap percentile interval]. Each statistic averages fold metrics within seed, equally averages seeds 21/44, and equally averages T0--T2. Threshold-dependent metrics use 0.5. Identical patient resamples preserve pairing across models, folds, seeds, and landmarks; entries are marginal model intervals, rather than intervals for differences. Intervals condition on the fitted models and exclude retraining and retrospective selection uncertainty. Downward arrows identify metrics for which lower is better.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:extended_macro}{{A.6}{18}{All 14 macro metrics for the principal variants: point estimate [95\% patient-bootstrap percentile interval]. Each statistic averages fold metrics within seed, equally averages seeds 21/44, and equally averages T0--T2. Threshold-dependent metrics use 0.5. Identical patient resamples preserve pairing across models, folds, seeds, and landmarks; entries are marginal model intervals, rather than intervals for differences. Intervals condition on the fitted models and exclude retraining and retrospective selection uncertainty. Downward arrows identify metrics for which lower is better}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.7}{\ignorespaces Exploratory paired patient-bootstrap intervals for three-landmark mean differences (2,000 shared patient draws). Intervals condition on the fitted models and exclude retraining and seed-selection uncertainty.}}{18}{table.7}\protected@file@percent }
\newlabel{tab:bootstrap}{{A.7}{18}{Exploratory paired patient-bootstrap intervals for three-landmark mean differences (2,000 shared patient draws). Intervals condition on the fitted models and exclude retraining and seed-selection uncertainty}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.8}{\ignorespaces Three-landmark mean operating-point sensitivity analysis, equally averaged over seeds 21 and 44 after within-seed five-fold aggregation. The alternative threshold maximizes Youden index separately on each fold and landmark validation set; the highest threshold breaks ties. No holdout predictions select thresholds. Probability-based AUROC and AP are unchanged by this operation.}}{18}{table.8}\protected@file@percent }
\newlabel{tab:extended_threshold}{{A.8}{18}{Three-landmark mean operating-point sensitivity analysis, equally averaged over seeds 21 and 44 after within-seed five-fold aggregation. The alternative threshold maximizes Youden index separately on each fold and landmark validation set; the highest threshold breaks ties. No holdout predictions select thresholds. Probability-based AUROC and AP are unchanged by this operation}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.7}{\ignorespaces Six complementary landmark summaries: AUROC, AP, F1, sensitivity, specificity, and Brier score. All points use fold-then-seed aggregation; shading is the conditional 95\% patient-bootstrap interval. The same 175 patients appear at every landmark. A trend in ranking can coexist with a different trend in calibration or error types.}}{19}{figure.7}\protected@file@percent }
\newlabel{fig:longitudinal}{{A.7}{19}{Six complementary landmark summaries: AUROC, AP, F1, sensitivity, specificity, and Brier score. All points use fold-then-seed aggregation; shading is the conditional 95\% patient-bootstrap interval. The same 175 patients appear at every landmark. A trend in ranking can coexist with a different trend in calibration or error types}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.9}{\ignorespaces Exploratory subgroup discrimination for the equal-weight seeds 21/44 mean. AUROC is averaged over five folds within each seed, then seeds 21/44 equally, and T0--T2; intervals are paired patient-bootstrap intervals for ForecastAttention minus NoJEPA, conditional on the fixed models. Age 50 is an exploratory reporting cutpoint. Namespace groups are parts of one clinical release, not external cohorts.}}{19}{table.9}\protected@file@percent }
\newlabel{tab:subgroups}{{B.9}{19}{Exploratory subgroup discrimination for the equal-weight seeds 21/44 mean. AUROC is averaged over five folds within each seed, then seeds 21/44 equally, and T0--T2; intervals are paired patient-bootstrap intervals for ForecastAttention minus NoJEPA, conditional on the fixed models. Age 50 is an exploratory reporting cutpoint. Namespace groups are parts of one clinical release, not external cohorts}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.10}{\ignorespaces Archived epoch 20 fixed-training-probe diagnostics, averaged within each seed over five folds and then equally over seeds 21/44. Skill is $1-\mathrm  {L1}_{forecast}/\mathrm  {L1}_{copy}$ within the corresponding EMA coordinates; positive is better than holding the landmark state constant. These are training-probe summaries, not best-checkpoint holdout forecast evaluations. NoJEPA has no trained-world diagnostic.}}{19}{table.10}\protected@file@percent }
\newlabel{tab:worldprobe}{{B.10}{19}{Archived epoch 20 fixed-training-probe diagnostics, averaged within each seed over five folds and then equally over seeds 21/44. Skill is $1-\mathrm {L1}_{forecast}/\mathrm {L1}_{copy}$ within the corresponding EMA coordinates; positive is better than holding the landmark state constant. These are training-probe summaries, not best-checkpoint holdout forecast evaluations. NoJEPA has no trained-world diagnostic}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.8}{\ignorespaces Outcome-conditioned changes in predicted pCR probability from T0 to T2. Panels separate models and outcome classes. Histograms are computed within each fitted model and then averaged over folds and seeds; they are not histograms of probability-ensemble predictions. Changes describe model scores and do not establish an individual treatment effect.}}{20}{figure.8}\protected@file@percent }
\newlabel{fig:scorechanges}{{A.8}{20}{Outcome-conditioned changes in predicted pCR probability from T0 to T2. Panels separate models and outcome classes. Histograms are computed within each fitted model and then averaged over folds and seeds; they are not histograms of probability-ensemble predictions. Changes describe model scores and do not establish an individual treatment effect}{figure.8}{}}
