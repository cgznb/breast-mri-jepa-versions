\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Exploratory heterogeneity and operating-point behavior. (A) Macro AUROC differences between ForecastAttention and NoJEPA within HR/HER2 and age groups, with patient counts, positive-outcome counts, and unadjusted paired intervals. No subgroup-interaction claim is made. (B) Specificity and sensitivity at threshold 0.5, showing the operating-point movement across landmarks. Colors identify models and markers identify landmarks.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:subgroups}{{5}{14}{Exploratory heterogeneity and operating-point behavior. (A) Macro AUROC differences between ForecastAttention and NoJEPA within HR/HER2 and age groups, with patient counts, positive-outcome counts, and unadjusted paired intervals. No subgroup-interaction claim is made. (B) Specificity and sensitivity at threshold 0.5, showing the operating-point movement across landmarks. Colors identify models and markers identify landmarks}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Archived fixed-training-probe diagnostics. (A) Copy-normalized latent forecast skill at common epoch 20; positive values outperform holding the current state constant in the same snapshot's EMA coordinates. (B) Predictor gradient norms from pCR and weighted rollout losses. (C) Three-step skill over common archived training epochs. Values average folds within seed and then seeds 21/44. Forecast targets require the real landmark, target, and all intermediate visits, so eligibility varies by horizon. These are training diagnostics, not holdout or best-checkpoint mechanism evaluations; three-step eligibility is only 5--9 patients per probe.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:mechanism}{{6}{14}{Archived fixed-training-probe diagnostics. (A) Copy-normalized latent forecast skill at common epoch 20; positive values outperform holding the current state constant in the same snapshot's EMA coordinates. (B) Predictor gradient norms from pCR and weighted rollout losses. (C) Three-step skill over common archived training epochs. Values average folds within seed and then seeds 21/44. Forecast targets require the real landmark, target, and all intermediate visits, so eligibility varies by horizon. These are training diagnostics, not holdout or best-checkpoint mechanism evaluations; three-step eligibility is only 5--9 patients per probe}{figure.6}{}}
