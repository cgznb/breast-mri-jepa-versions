\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Paired model differences at T0, T1, T2, and the landmark macro. Colors distinguish the auxiliary-supervision contrast, the additional forecast-readout contrast, and the complete-model contrast. Squares denote macro estimates; bars are 95\% patient-bootstrap intervals, with identical patient draws shared across models, folds, seeds, and landmarks. Fold or seed counts are not independent patient sample sizes.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:paired}{{3}{11}{Paired model differences at T0, T1, T2, and the landmark macro. Colors distinguish the auxiliary-supervision contrast, the additional forecast-readout contrast, and the complete-model contrast. Squares denote macro estimates; bars are 95\% patient-bootstrap intervals, with identical patient draws shared across models, folds, seeds, and landmarks. Fold or seed counts are not independent patient sample sizes}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Extended threshold-dependent metrics at probability threshold 0.5. Values first average five fold metrics within each seed and then equally average seeds 21 and 44 on the same 175 holdout patients; Macro equally averages landmarks. PPV and NPV denote positive and negative predictive value; BA is balanced accuracy.}}{11}{table.3}\protected@file@percent }
\newlabel{tab:extended_operating}{{3}{11}{Extended threshold-dependent metrics at probability threshold 0.5. Values first average five fold metrics within each seed and then equally average seeds 21 and 44 on the same 175 holdout patients; Macro equally averages landmarks. PPV and NPV denote positive and negative predictive value; BA is balanced accuracy}{table.3}{}}
