\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Performance on the fixed internal holdout (175 patients, 56 pCR positive). Each value averages five fold metrics within a seed, then equally averages seeds 21 and 44. Macro averages the three landmarks. AP denotes average precision; F1 uses threshold 0.5.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{10}{Performance on the fixed internal holdout (175 patients, 56 pCR positive). Each value averages five fold metrics within a seed, then equally averages seeds 21 and 44. Macro averages the three landmarks. AP denotes average precision; F1 uses threshold 0.5}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Discrimination across matched landmarks. (A--C) ROC curves; (D--F) precision--recall curves. Curves are calculated separately in each fold model, then averaged within seed and across seeds 21/44. Shading shows pointwise 95\% paired patient-bootstrap intervals conditional on the fitted models. Colored values are the corresponding fold-then-seed mean AUROC or AP; interpolated curve areas need not equal these separately calculated statistics. The dotted PR reference is the 0.32 positive prevalence.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:discrimination}{{2}{10}{Discrimination across matched landmarks. (A--C) ROC curves; (D--F) precision--recall curves. Curves are calculated separately in each fold model, then averaged within seed and across seeds 21/44. Shading shows pointwise 95\% paired patient-bootstrap intervals conditional on the fitted models. Colored values are the corresponding fold-then-seed mean AUROC or AP; interpolated curve areas need not equal these separately calculated statistics. The dotted PR reference is the 0.32 positive prevalence}{figure.2}{}}
