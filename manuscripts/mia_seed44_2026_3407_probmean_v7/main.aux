\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Performance on the fixed internal holdout (175 patients, 56 pCR positive). Entries are mean $\pm $ sample SD over seeds 44, 2026, and 3407. Within each seed, five fold probabilities are averaged per patient before metrics; no probabilities are averaged across seeds. Macro averages T0--T2 metrics within each seed. F1 uses threshold 0.5. Paired Macro differences and adjusted tests are in Table~\ref {tab:bootstrap}.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{11}{Performance on the fixed internal holdout (175 patients, 56 pCR positive). Entries are mean $\pm $ sample SD over seeds 44, 2026, and 3407. Within each seed, five fold probabilities are averaged per patient before metrics; no probabilities are averaged across seeds. Macro averages T0--T2 metrics within each seed. F1 uses threshold 0.5. Paired Macro differences and adjusted tests are in Table~\ref {tab:bootstrap}}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Discrimination across seeds 44, 2026, and 3407. (A--C) Mean ROC curves; (D--F) mean precision--recall curves. Curves are computed from five-fold ensemble probabilities separately within each seed, interpolated on a common grid, and equally averaged across seeds. Shading gives pointwise conditional 95\% shared-patient-bootstrap intervals for the mean curve. Colored metric values are means of the directly computed seed-specific AUROC or non-interpolated AP; they need not equal the area under the displayed mean curve. The dotted PR reference is the 0.32 positive prevalence.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:discrimination}{{2}{11}{Discrimination across seeds 44, 2026, and 3407. (A--C) Mean ROC curves; (D--F) mean precision--recall curves. Curves are computed from five-fold ensemble probabilities separately within each seed, interpolated on a common grid, and equally averaged across seeds. Shading gives pointwise conditional 95\% shared-patient-bootstrap intervals for the mean curve. Colored metric values are means of the directly computed seed-specific AUROC or non-interpolated AP; they need not equal the area under the displayed mean curve. The dotted PR reference is the 0.32 positive prevalence}{figure.2}{}}
