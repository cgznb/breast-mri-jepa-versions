\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Exploratory subgroup and operating-point summaries, computed separately within seed-44 folds and averaged across folds. (A) Macro AUROC differences between ForecastAttention and NoJEPA within HR/HER2 and age groups, with patient counts, positive outcomes, and unadjusted shared-patient intervals. No subgroup-interaction claim is made. (B) Mean specificity and sensitivity at threshold 0.5 across landmarks; colors identify variants and markers identify landmarks.}}{15}{figure.5}\protected@file@percent }
\newlabel{fig:subgroups}{{5}{15}{Exploratory subgroup and operating-point summaries, computed separately within seed-44 folds and averaged across folds. (A) Macro AUROC differences between ForecastAttention and NoJEPA within HR/HER2 and age groups, with patient counts, positive outcomes, and unadjusted shared-patient intervals. No subgroup-interaction claim is made. (B) Mean specificity and sensitivity at threshold 0.5 across landmarks; colors identify variants and markers identify landmarks}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Archived seed-44 fixed-training-probe diagnostics. (A) Copy-normalized forecast skill at common epoch 20. (B) Predictor gradient norms from pCR and weighted rollout losses. (C) Three-step skill across epochs with complete diagnostic coverage. Statistics are calculated within each snapshot's EMA coordinates and summarized descriptively across five folds. These training diagnostics are distinct from holdout pCR metrics; real continuous visit chains are required, and three-step eligibility is only 5--9 patients per probe.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:mechanism}{{6}{15}{Archived seed-44 fixed-training-probe diagnostics. (A) Copy-normalized forecast skill at common epoch 20. (B) Predictor gradient norms from pCR and weighted rollout losses. (C) Three-step skill across epochs with complete diagnostic coverage. Statistics are calculated within each snapshot's EMA coordinates and summarized descriptively across five folds. These training diagnostics are distinct from holdout pCR metrics; real continuous visit chains are required, and three-step eligibility is only 5--9 patients per probe}{figure.6}{}}
